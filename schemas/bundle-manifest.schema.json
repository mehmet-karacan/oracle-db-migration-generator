{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/oracle-db-migration-generator/1.0/bundle-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bundle-manifest/1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "media_type"
        ]
      },
      "minItems": 1
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "plan_id",
    "target_id",
    "files",
    "execution_status"
  ]
}
