{# Şema Karşılaştırma kayıtlı alanları kaynak ve hedef sütunlarında gösterir.
Author: Mehmet KARACAN
Date: 2026-11-09 #}
<div class="field-compare-scroll" tabindex="0" aria-label="Kaynak ve Hedef Alanları"><table class="field-compare-table"><colgroup><col class="field-name-col"><col class="field-value-col"><col class="field-value-col"></colgroup><thead><tr><th scope="col">Özellik</th><th scope="col"><span>Kaynak</span><small>{{ context.source_label }}</small></th><th scope="col"><span>Hedef</span><small>{{ context.target_label }}</small></th></tr></thead><tbody>{% for row in comparison_rows %}<tr data-change-id="{{ row.id }}" data-kind="{{ row.kind }}"><th scope="row"><small>{{ row.group }}</small><strong>{{ row.field }}</strong><span class="field-kind">{{ row.kind_label }}</span>{% if row.parts>1 %}<small>Bölüm {{ row.part }} / {{ row.parts }}</small>{% endif %}</th><td class="field-source" data-state="{{ row.source_state }}"><pre data-side="source"><code>{{ row.source }}</code></pre>{% if row.clipped %}<small class="field-value-note">Kısa Gösterim</small>{% endif %}</td><td class="field-target" data-state="{{ row.target_state }}"><pre data-side="target"><code>{{ row.target }}</code></pre>{% if row.clipped %}<small class="field-value-note">Kısa Gösterim</small>{% endif %}</td></tr>{% endfor %}</tbody></table></div>
