{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/oracle-db-migration-generator/1.0/run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "run/1.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        10,
        20,
        30,
        40
      ]
    },
    "build_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "status": {
            "enum": [
              "NO_CHANGE",
              "NO_ACTION",
              "READY",
              "REVIEW_REQUIRED",
              "BLOCKED",
              "ERROR",
              "INCOMPLETE",
              "INCONSISTENT"
            ]
          },
          "difference_count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "publication": {
            "enum": [
              "NOT_REQUESTED",
              "PUBLISHED",
              "UNCHANGED",
              "FAILED"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "difference_count",
          "plan_id",
          "plan_path",
          "captured_at",
          "error_code",
          "publication"
        ]
      },
      "minItems": 1
    },
    "build_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "artifact_git_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "run_id",
    "started_at",
    "finished_at",
    "source_commit",
    "status",
    "exit_code",
    "build_url",
    "targets"
  ]
}
