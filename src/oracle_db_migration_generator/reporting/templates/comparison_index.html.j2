{# Şema Karşılaştırma kaynak ve hedef farklarının eksiksiz nesne dizinini gösterir.
Author: Mehmet KARACAN
Date: 2026-11-09 #}
<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title>Kaynak ve Hedef Farkları</title><link rel="stylesheet" href="../assets/report.css"></head><body class="comparison-report"><div class="shell">{% include 'web_header.html.j2' %}<main class="pad report-main"><h1 class="title">Kaynak ve Hedef Farkları</h1><div class="environment-pair"><div><span>Kaynak Şema</span><strong>{{ context.source_label }}</strong></div><div><span>Hedef Şema</span><strong>{{ context.target_label }}</strong></div></div><p class="comparison-scope">{{ total|count_tr }} nesnenin kayıtlı alan farkları. Bir nesne seçerek kaynak ve hedef değerlerini yan yana inceleyebilirsiniz. İşlem oluşturulmayan farklar da bu listede bulunur.</p><div class="tablewrap"><table class="table"><thead><tr><th scope="col">Nesne</th><th scope="col">Nesne Türü</th><th scope="col">Alan Farkı</th></tr></thead><tbody>{% for obj in objects %}<tr><td><a href="{{ obj.key }}-0001.html">{{ obj.label }}</a></td><td>{{ obj.type_label }}</td><td>{{ obj.total|count_tr }}</td></tr>{% else %}<tr><td colspan="3">Kayıtlı alan farkı bulunmuyor.</td></tr>{% endfor %}</tbody></table></div><nav class="report-pagination" aria-label="Nesne Dizini Sayfaları">{% for number in page_links %}<a href="index-{{ '%04d'|format(number) }}.html"{% if number==page %} aria-current="page"{% endif %}>{{ number }}</a>{% endfor %}<span>Toplam {{ pages|count_tr }} Sayfa</span></nav></main><footer class="report-footer pad">© 2026 İnnova Bilişim Çözümleri A.Ş.</footer></div></body></html>
