              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "snapshot_id"
          ]
        }
      },
      "required": [
        "profile_id",
        "commit_sha",
        "ddl_digest"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "origin"
            ]
