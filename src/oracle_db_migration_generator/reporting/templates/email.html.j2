{# Oracle DB Migration Generator çalışma özetini eposta için HTML olarak gösterir.
Author: Mehmet KARACAN
Date: 2026-11-02 #}
<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title>Şema karşılaştırması</title>
<style type="text/css">@media only screen and (max-width:640px){.mail-shell{width:100%!important;max-width:100%!important}.pad{padding-left:18px!important;padding-right:18px!important}.metric{display:inline-block!important;width:32%!important;box-sizing:border-box!important;border-bottom:1px solid #DFE5EB!important}.header-tagline{display:none!important}.data-table td,.data-table th{padding:7px 5px!important;font-size:10px!important;word-break:break-word!important}.hero-title{font-size:27px!important;line-height:34px!important}.narrow-hide{display:none!important}.scope-item{display:inline-block!important;width:50%!important;box-sizing:border-box!important}.scope-total,.scope-breakdown{display:block!important;width:100%!important;box-sizing:border-box!important}.scope-total{border-right:0!important;border-bottom:1px solid #DFE5EB!important}}</style></head>
<body style="margin:0!important;padding:0!important;background:#EBF0F4;color:#253142;font-family:Aptos,Calibri,'Segoe UI',Arial,sans-serif;font-size:15px;line-height:1.55;-webkit-text-size-adjust:100%">
<table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#EBF0F4" style="border-collapse:collapse;width:100%;background:#EBF0F4"><tr><td align="center" style="padding:24px 12px">
<!--[if mso]><table role="presentation" width="820" align="center"><tr><td><![endif]-->
<table role="presentation" class="mail-shell" width="820" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF" style="border-collapse:collapse;margin:0 auto;width:100%;max-width:820px;background:#FFFFFF">
<tr><td class="pad" style="padding:27px 34px 18px"><img src="{{ logo }}" width="156" height="30" alt="İnnova" style="border:0;display:block;width:156px;height:30px"></td></tr>
<tr><td class="pad" style="padding:7px 34px 22px"><h1 class="hero-title" style="font-size:34px;line-height:42px;font-weight:700;color:#111B2D;margin:0 0 8px;letter-spacing:-.4px">Şema karşılaştırması</h1>{% if view.source_schemas %}<p style="font-size:14px;line-height:21px;margin:0 0 3px;color:#46566B"><strong>Kaynak Şema</strong> {{ view.source_schemas|join(', ') }}</p>{% endif %}{% if view.targets %}<p style="font-size:14px;line-height:21px;margin:0;color:#46566B"><strong>Hedef{% if view.targets|length > 1 %}ler{% endif %}</strong> {% for target in view.targets %}{{ target.name }}{% if target.schema_subtitle %} ({{ target.schema_subtitle }}){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}<p class="timing-summary" style="margin:12px 0 0;font-size:14px;line-height:21px;color:#46566B;font-weight:600;overflow-wrap:anywhere">{% if view.comparison_duration_label == 'Ölçülemedi' %}Karşılaştırma süresi ölçülemedi.{% else %}Karşılaştırma {{ view.comparison_duration_label }} sürdü.{% endif %}</p></td></tr>
<tr><td class="pad" style="padding:0 34px 25px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%"><tr><td class="metric" width="20%" valign="top" bgcolor="#F3F6F8" style="width:20%;padding:14px 9px;border-right:1px solid #DFE5EB;background:#F3F6F8"><div style="font-size:24px;font-weight:700;line-height:29px;color:#111B2D">{{ view.metrics[0].value }}</div><div style="font-size:11px;color:#77869A;line-height:17px">Hedef Ortam</div></td><td class="metric" width="20%" valign="top" bgcolor="#F3F6F8" style="width:20%;padding:14px 9px;border-right:1px solid #DFE5EB;background:#F3F6F8"><div style="font-size:24px;font-weight:700;line-height:29px;color:#111B2D">{{ view.metrics[1].value }}</div><div style="font-size:11px;color:#77869A;line-height:17px">Bulunan Fark</div></td><td class="metric" width="20%" valign="top" bgcolor="#F3F6F8" style="width:20%;padding:14px 9px;border-right:1px solid #DFE5EB;background:#F3F6F8"><div style="font-size:24px;font-weight:700;line-height:29px;color:#111B2D">{{ view.metrics[2].value }}</div><div style="font-size:11px;color:#77869A;line-height:17px">Üretilen DDL</div></td><td class="metric" width="20%" valign="top" bgcolor="#F3F6F8" style="width:20%;padding:14px 9px;border-right:1px solid #DFE5EB;background:#F3F6F8"><div style="font-size:24px;font-weight:700;line-height:29px;color:#111B2D">{{ view.metrics[3].value }}</div><div style="font-size:11px;color:#77869A;line-height:17px">{{ view.metrics[3].label }}</div></td><td class="metric" width="20%" valign="top" bgcolor="#F3F6F8" style="width:20%;padding:14px 9px;border-right:1px solid #DFE5EB;background:#F3F6F8"><div style="font-size:24px;font-weight:700;line-height:29px;color:#111B2D">{{ view.metrics[4].value }}</div><div style="font-size:11px;color:#77869A;line-height:17px">{{ view.metrics[4].label }}</div></td></tr></table></td></tr>
{% if view.targets|length == 1 %}<tr><td class="pad" style="padding:0 34px 20px"><p style="margin:0;font-size:14px;color:#46566B"><strong>{{ view.targets[0].display_status }}</strong></p><p style="margin:3px 0 0;font-size:12px;line-height:18px;color:#68778B">{{ view.targets[0].status_reason }}</p></td></tr>{% endif %}
<tr><td class="pad" style="padding:0 34px 24px">{% include "ddl_types_email.html.j2" %}</td></tr>
<tr><td class="pad" style="padding:0 34px 24px">{% with scan_scope=view.scan_scope %}{% include "scan_scope.html.j2" %}{% endwith %}</td></tr>
{% if view.difference_note %}<tr><td class="pad" style="padding:0 34px 18px"><p style="margin:0;color:#68778B;font-size:13px;line-height:20px">{{ view.difference_note }}</p></td></tr>{% endif %}
<tr><td class="pad" style="padding:0 34px 23px"><p style="margin:0;color:#68778B;font-size:12px;line-height:18px">Hazırlanan SQL veritabanına uygulanmadı. Kaynak ve hedef salt okunur.</p></td></tr>
{% if view.targets|length != 1 %}
<tr><td class="pad" style="padding:0 34px 25px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 12px"><tr><td width="5" bgcolor="#CF1838" style="width:5px;background:#CF1838;font-size:1px">&nbsp;</td><td style="padding-left:16px"><h2 style="margin:0;font-size:21px;line-height:28px;color:#131E30;font-weight:700">Hedef Ortam Özeti</h2></td></tr></table><table role="table" class="data-table" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #DCE4EB;border-collapse:collapse;width:100%;table-layout:fixed"><thead><tr><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Hedef</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Bulunan Fark</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'Üretilen DDL' if view.proposal_catalog_known else 'DDL' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'Taranan Nesne' if view.proposal_catalog_known else 'İnceleme' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'DDL Dosyası Eksik' if view.proposal_catalog_known else 'Üretilemeyen DDL' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Durum</th></tr></thead><tbody>{% for t in view.critical_targets %}<tr><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><strong data-target-id="{{ t.id }}">{{ t.name }}</strong>{% if t.schema_subtitle %}<br>{{ t.schema_subtitle }}{% endif %}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.confirmed_difference_count|count_tr if t.confirmed_difference_count is not none else 'Sonuç alınamadı' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.generated_ddl_count|count_tr if view.proposal_catalog_known and t.counts else t.counts.ready_operations|count_tr if t.counts else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.source_object_count|count_tr if view.proposal_catalog_known and t.source_object_count is not none else t.counts.review_operations|count_tr if t.counts and not view.proposal_catalog_known else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.missing_ddl_count|count_tr if view.proposal_catalog_known and t.counts else t.counts.blocked_operations|count_tr if t.counts else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.display_status }}<div style="font-size:11px;line-height:16px;color:#68778B;margin-top:4px">{{ t.status_reason }}</div></td></tr>{% else %}<tr><td colspan="6" style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">Hedef sonucu bulunmuyor.</td></tr>{% endfor %}</tbody></table><p style="color:#7A889B;font-size:11px;line-height:16px;margin:8px 0 0">Çok sayıda hedef bulunduğunda e-postada en yüksek öncelikli 5 hedef gösterilir. Tam liste artifact paketindedir.</p></td></tr>
{% endif %}
<tr><td class="pad" style="padding:0 34px 24px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 12px"><tr><td width="5" bgcolor="#CF1838" style="width:5px;background:#CF1838;font-size:1px">&nbsp;</td><td style="padding-left:16px"><h2 style="margin:0;font-size:21px;line-height:28px;color:#131E30;font-weight:700">Değişiklik Detayları</h2></td></tr></table><p style="font-size:12px;color:#68778B;margin:0 0 10px">Önem sırasına göre en fazla 5 benzersiz nesne. Aynı nesnenin birden fazla hedefteki farkları tek satırda özetlenir.</p><table role="table" class="data-table" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #DCE4EB;border-collapse:collapse;width:100%;table-layout:fixed"><thead><tr><th width="58%" align="left" style="width:58%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Nesne / Fark</th><th width="25%" align="left" style="width:25%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Hedef</th><th width="17%" align="left" style="width:17%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Sonuç</th></tr></thead><tbody>{% for o in view.important_objects %}<tr><td style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><strong>{{ o.object_label }}</strong><br>{{ o.type_label }}<div class="object-reason" style="margin-top:5px;font-size:11px;line-height:16px;color:#68778B;white-space:normal;overflow-wrap:anywhere;word-break:break-word">{{ o.mail_reason }}</div></td><td style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ o.target_label }}</td><td style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ o.display_status }}</td></tr>{% else %}<tr><td colspan="3" style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">Raporlanacak nesne yok.</td></tr>{% endfor %}</tbody></table><div style="margin-top:10px;background:#F3F6F8;color:#46566B;padding:12px 16px;font-size:12px;line-height:19px">{{ view.unique_objects|count_tr }} benzersiz nesneden {{ view.important_objects|length|count_tr }} nesne gösterildi. Tüm nesneler ve tam SQL'ler, ilgili hedefin <strong>Genel DDL</strong> veya <strong>Nesne Bazlı DDL</strong> bağlantısından indirilebilir.</div></td></tr>
<tr><td class="pad" style="padding:0 34px 25px"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 12px"><tr><td width="5" bgcolor="#CF1838" style="width:5px;background:#CF1838;font-size:1px">&nbsp;</td><td style="padding-left:16px"><h2 style="margin:0;font-size:21px;line-height:28px;color:#131E30;font-weight:700">Kaynak ve İzlenebilirlik</h2></td></tr></table><table role="presentation" width="100%" cellspacing="0" cellpadding="0" bgcolor="#F3F6F8" style="background:#F3F6F8;border-collapse:collapse"><tr><td width="50%" valign="top" style="padding:16px;font-size:12px;line-height:20px;color:#48576D;border-right:1px solid #DEE5EC"><strong style="color:#27364A">{{ 'Oracle kaynak snapshot' if view.run.get('source_origin') else 'Kaynak SHA' }}</strong> <span style="overflow-wrap:anywhere;word-break:break-all">{{ view.run.source_origin.snapshot_id if view.run.get('source_origin') else view.run.source_commit }}</span><br><strong style="color:#27364A">Çalışma kimliği</strong> <span style="overflow-wrap:anywhere;word-break:break-all">{{ view.run.run_id }}</span><br><strong style="color:#27364A">Kapsam</strong> Bir kaynak ve {{ view.metrics[0].value }} hedef</td><td width="50%" valign="top" style="padding:16px;font-size:12px;line-height:20px;color:#48576D"><strong style="color:#27364A">Çalışma</strong> {{ view.run.get('build_number') if view.run.get('build_number') is not none else 'Yerel' }}<br><strong style="color:#27364A">Sonuç</strong> SQL üretildi, uygulanmadı</td></tr></table><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td style="padding:17px 0 0">{% if view.link %}<a href="{{ view.link }}" style="font-size:13px;font-weight:700;color:#BF1533;text-decoration:underline">DDL dosyalarını ve ayrıntılı raporları aç</a>{% endif %}<p style="font-size:11px;line-height:17px;color:#788599;margin:6px 0 0">{{ view.link_note }}</p></td></tr></table></td></tr>
<tr><td class="pad" style="border-top:1px solid #E3E8ED;padding:18px 34px 23px"><table role="presentation" width="100%"><tr><td style="font-size:11px;color:#7E8B9B">© 2026 İnnova Bilişim Çözümleri A.Ş.</td><td align="right" style="font-size:11px;color:#6F7C8B"><strong>SQL veritabanına uygulanmadı.</strong></td></tr></table></td></tr>
</table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>
