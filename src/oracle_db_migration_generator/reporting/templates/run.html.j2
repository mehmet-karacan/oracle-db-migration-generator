<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Oracle Şema Karşılaştırma Raporu | İnnova</title><link rel="stylesheet" href="assets/report.css"></head>
<body><div class="shell">
<header class="header pad"><div class="brand"><img src="assets/innova-logo.png" alt="İnnova"><small>Daha akıllı<br>Daha güçlü yarınlara</small></div><div class="right muted small">İnsan için teknoloji.<br>Daha iyi bir gelecek.</div></header>
<main class="pad">
<div class="report-heading"><div><p class="eyebrow">ORACLE DB MIGRATION GENERATOR</p><h1 class="title">Oracle Şema Karşılaştırma Raporu</h1><p class="muted">Kaynak yapı ile hedef durumu · DDL üretimi</p></div><span class="pill">{{ view.display_status }}</span></div>
<p class="timing-summary">Karşılaştırma süresi: {{ view.comparison_duration_label }}</p>
<div class="metrics">{% for metric in view.metrics %}<div class="metric"><strong>{{ metric.value }}</strong><span>{{ metric.label }}</span></div>{% endfor %}</div>
{% if view.difference_note %}<p class="note">{{ view.difference_note }}</p>{% endif %}
<div class="spacer"></div>{% with scan_scope=view.scan_scope %}{% include "scan_scope.html.j2" %}{% endwith %}
<div class="spacer"></div><h2 class="section">Hedef ve DDL Dosyaları</h2>
<p class="small muted">Üretilen SQL uygulanmadı. Hazır alt küme, inceleme gerektiren ve üretilemeyen işlemleri içermez.</p>
{% if pages>1 %}<nav class="pagination" aria-label="Hedef sayfaları">{% for n in range(pages) %}<a href="{{ 'index.html' if n==0 else 'targets-%04d.html'|format(n+1) }}">{{ n+1 }}</a>{% endfor %}</nav>{% endif %}
<div class="targetgrid{{ ' single' if targets|length==1 else '' }}">
{% for t in targets %}<section class="target">
<div class="target-heading"><div><strong data-target-id="{{ t.id }}">{{ t.name }}</strong><p>Şema: {{ t.schemas|join(', ') if t.schemas else 'Doğrulanamadı' }}</p></div><span class="pill">{{ t.display_status }}</span></div>
{% if t.counts %}<dl class="target-counts"><div><dt>Bulunan fark</dt><dd>{{ t.confirmed_difference_count|count_tr if t.confirmed_difference_count is not none else 'Sonuç alınamadı' }}</dd></div><div><dt>Hazır DDL</dt><dd>{{ t.counts.ready_operations|count_tr }}</dd></div><div><dt>İnceleme</dt><dd>{{ t.counts.review_operations|count_tr }}</dd></div><div><dt>Üretilemeyen DDL</dt><dd>{{ t.counts.blocked_operations|count_tr }}</dd></div></dl>{% else %}<p>Hedef bilgileri alınamadı.</p>{% endif %}
<p class="target-reason">{{ t.status_reason }}</p>
<div class="toolbar target-actions">{% if t.aggregate_view_path %}<a class="link primary" href="{{ t.aggregate_view_path }}">Genel DDL’i görüntüle</a>{% elif t.aggregate_path %}<a class="link primary" href="{{ t.aggregate_path }}" download>Genel DDL’i indir</a>{% endif %}{% if t.download_path %}<a class="link" href="{{ t.download_path }}">DDL dosyalarını indir</a>{% elif t.objects_path %}<a class="link" href="{{ t.objects_path }}">Nesne bazlı dosyalar</a>{% endif %}{% if t.report_path %}<a class="link" href="{{ t.report_path }}">Hedef ayrıntıları</a>{% endif %}</div>
{% if t.aggregate_path %}<p class="download-note">Genel DDL, nesne dosyalarını sırayla çağıran ana SQL betiğidir. {% if t.download_path %}İndirmek için dosya listesinden tüm dosyaları ZIP olarak alabilirsiniz.{% else %}Ana betik ve nesne dosyalarının dizin yapısını birlikte koruyun.{% endif %}</p>{% endif %}
{% if t.plan_path %}<details class="technical"><summary>Teknik dosyalar</summary><div class="toolbar"><a class="link" href="{{ t.plan_path }}">Plan JSON</a><a class="link" href="{{ t.manifest_path }}">Dosya doğrulama manifesti</a></div></details>{% endif %}
</section>{% else %}<p>Hedef sonucu bulunmuyor.</p>{% endfor %}</div>
<div class="spacer"></div><h2 class="section">Önemli Nesneler</h2><p class="meta">{{ view.unique_objects|count_tr }} benzersiz nesneden ilk {{ view.important_objects|length|count_tr }}. Tam liste ve gerekçeler hedef ayrıntılarındadır.</p>
<div class="tablewrap"><table class="table"><thead><tr><th>Nesne / Tür</th><th>Hedef</th><th>İşlem / Durum</th><th>Gerekçe</th></tr></thead><tbody>{% for o in view.important_objects %}<tr><td><strong>{{ o.object_label }}</strong><br><span class="muted">{{ o.type_label }}</span>{% if o.object.object_type in ['COMMENT','GRANT'] and not o.object.get('display_name') %}<br><a href="{{ o.evidence_path }}">Bağlı nesne kanıtı</a>{% endif %}</td><td>{{ o.target_label }}</td><td>{{ o.kinds|join(', ') }}<br>{{ o.display_status }}</td><td class="small muted">{{ o.reason }}</td></tr>{% else %}<tr><td colspan="4">Raporlanacak nesne yok.</td></tr>{% endfor %}</tbody></table></div>
<div class="spacer"></div><h2 class="section">Kaynak ve İzlenebilirlik</h2><p class="wrap meta">{{ 'Oracle kaynak snapshot' if view.run.get('source_origin') else 'Kaynak SHA' }}: {{ view.run.source_origin.snapshot_id if view.run.get('source_origin') else view.run.source_commit }}<br>Çalışma: {{ view.run.run_id }}</p><p class="meta">{{ view.link_note }} {% if view.link %}<a href="{{ view.link }}">Çalışma kaydı</a>{% endif %}</p><details class="technical"><summary>Çalışma dosyaları</summary><div class="toolbar"><a class="link" href="run.json">Çalışma JSON</a><a class="link" href="README.md">Çalışma açıklaması</a></div></details>
</main><footer class="pad footer"><span>Güvenilir teknoloji, sürdürülebilir yarınlar.</span><span>Üretildi · SQL uygulanmadı</span></footer>
</div></body></html>