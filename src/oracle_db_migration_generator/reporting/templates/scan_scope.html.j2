{# Şema Karşılaştırma kaynak tarama kapsamını ortak raporlarda gösterir.
Author: Mehmet KARACAN
Date: 2026-11-07 #}
<section aria-label="Tarama Kapsamı">
{% with heading_icon='scan', heading_label='Tarama Kapsamı' %}{% include "email_heading.html.j2" %}{% endwith %}
<table role="presentation" class="scope-panel mail-panel" width="100%" cellpadding="0" cellspacing="0" bgcolor="#F3F6F8" style="width:100%;table-layout:fixed;border-collapse:collapse;background:#F3F6F8"><tr>
<td class="scope-total" width="25%" style="width:25%;padding:18px 16px;border:0;border-right:1px solid #DFE5EB;vertical-align:middle">
<div style="margin:0 0 8px">{{ report_icon('inventory', 24, accent=True) }}</div>
<div class="scope-label" style="font-size:12px;line-height:18px;color:#526174;font-weight:700">Toplam Taranan Nesne</div>
<div class="scope-value" style="margin-top:3px;font-size:28px;line-height:34px;font-weight:700;color:#1B283B">{{ scan_scope.source_total|count_tr if scan_scope.source_total is not none else 'Bilinmiyor' }}</div>
<div class="scope-caption" style="font-size:12px;line-height:18px;color:#526174">Kaynak Envanteri</div>
</td><td class="scope-breakdown" width="75%" style="width:75%;padding:8px 12px;border:0;vertical-align:middle">
{% if scan_scope.rows %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;table-layout:fixed;border-collapse:collapse">
{% for group in scan_scope.rows|batch(4) %}<tr>{% for row in group %}<td class="scope-item" width="25%" style="width:25%;padding:7px 6px;border:0;vertical-align:top;overflow-wrap:anywhere"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;table-layout:fixed"><tr><td width="26" rowspan="2" valign="top" style="width:26px;vertical-align:top;padding-top:1px">{{ report_type_icon(row.label, 18) }}</td><td class="scope-name" height="32" valign="top" style="height:32px;vertical-align:top;font-size:12px;line-height:16px;color:#526174">{{ row.label }}</td></tr><tr><td class="scope-value" style="font-size:16px;line-height:22px;font-weight:700;color:#1B283B">{{ row.count|count_tr }}</td></tr></table></td>{% endfor %}</tr>{% endfor %}
</table>{% else %}<p class="mail-note" style="margin:0;padding:8px 6px;font-size:12px;line-height:18px;color:#526174">{{ 'Tür dağılımı kaydedilmedi.' if scan_scope.source_total is none else 'Kaynakta kapsam içi nesne bulunmadı.' }}</p>{% endif %}
</td></tr></table>
<p class="scope-note" style="margin:8px 0 0;font-size:12px;line-height:18px;color:#526174;overflow-wrap:anywhere">{{ scan_scope.note }}</p>
</section>
