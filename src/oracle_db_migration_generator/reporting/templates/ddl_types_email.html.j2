{# Şema Karşılaştırma epostasındaki üretilen DDL türlerini gösterir.
Author: Mehmet KARACAN
Date: 2026-11-06 #}
<section aria-label="Üretilen DDL türleri">
{% with heading_icon='code', heading_label='Üretilen DDL' %}{% include "email_heading.html.j2" %}{% endwith %}
<table role="presentation" class="mail-panel" width="100%" cellpadding="0" cellspacing="0" bgcolor="#F3F6F8" style="width:100%;table-layout:fixed;border-collapse:collapse;background:#F3F6F8"><tr>
<td class="scope-total" width="25%" style="width:25%;padding:18px 16px;border-right:1px solid #DFE5EB;vertical-align:middle"><div style="margin:0 0 8px">{{ report_icon('code', 24, accent=True) }}</div><div class="scope-label" style="font-size:12px;line-height:18px;color:#526174;font-weight:700">Toplam DDL İşlemi</div><div class="scope-value" style="font-size:28px;line-height:34px;font-weight:700;color:#1B283B">{{ view.ddl_types.total|count_tr }}</div></td>
<td class="scope-breakdown" width="75%" style="width:75%;padding:8px 12px;vertical-align:middle">
{% if view.ddl_types.rows %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;table-layout:fixed;border-collapse:collapse">{% for group in view.ddl_types.rows|batch(4) %}<tr>{% for row in group %}<td class="scope-item" width="25%" style="width:25%;padding:7px 6px;vertical-align:top;overflow-wrap:anywhere"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;table-layout:fixed"><tr><td width="26" rowspan="2" valign="top" style="width:26px;vertical-align:top;padding-top:1px">{{ report_type_icon(row.label, 18) }}</td><td class="scope-name" height="32" valign="top" style="height:32px;vertical-align:top;font-size:12px;line-height:16px;color:#526174">{{ row.label }}</td></tr><tr><td class="scope-value" style="font-size:16px;line-height:22px;font-weight:700;color:#1B283B">{{ row.count|count_tr }}</td></tr></table></td>{% endfor %}</tr>{% endfor %}</table>{% else %}<p class="mail-note" style="margin:0;padding:8px 6px;font-size:12px;color:#526174">{{ 'Bu çalışmada DDL işlemi üretilmedi.' if view.ddl_types.total == 0 else 'DDL tür dağılımı doğrulanamadı.' }}</p>{% endif %}
</td></tr></table>
<p class="mail-note" style="margin:8px 0 0;font-size:12px;line-height:18px;color:#526174">Sayılar DDL işlemlerini gösterir. Aynı nesne için birden fazla işlem bulunabilir.</p>
</section>
