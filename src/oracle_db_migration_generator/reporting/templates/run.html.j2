{# Oracle DB Migration Generator çalışma özetini okunabilir HTML olarak gösterir.
Author: Mehmet KARACAN
Date: 2026-11-02 #}
<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><title>Schema Compare</title><link rel="stylesheet" href="assets/report.css"></head>
<body class="run-report"><div class="shell">
{% set prefix='' %}{% include 'web_header.html.j2' %}
<main class="pad report-main">
<div class="report-heading"><div><h1 class="title">Schema Compare</h1></div><span class="pill">{{ view.display_status }}</span></div>
<div class="environment-pair"><div><span>Kaynak Şema</span><strong>{% for schema in view.source_schemas %}{{ schema }}{% if view.source_environment %} - {{ view.source_environment }}{% endif %}{{ ', ' if not loop.last else '' }}{% else %}Kaynak Şema Bilgisi Yok{% endfor %}</strong></div><div><span>Hedef Şema</span><strong>{% for target in targets %}{{ target.name }}{% if target.schema_subtitle %} ({{ target.schema_subtitle }}){% endif %}{{ ', ' if not loop.last else '' }}{% else %}Hedef sonucu bulunmuyor.{% endfor %}</strong></div></div>
<p class="timing-summary">{{ report_icon('time', 18) }} {% if view.comparison_duration_label == 'Ölçülemedi' %}Karşılaştırma süresi ölçülemedi.{% else %}Karşılaştırma {{ view.comparison_duration_label }} sürdü.{% endif %}</p>
<div class="metrics">{% for metric in view.metrics[1:] %}<div class="metric"><span class="metric-label">{{ report_icon(metric_icon(loop.index, view.proposal_catalog_known), 24, accent=True) }} {{ metric.label }}</span><strong>{{ metric.value }}</strong></div>{% endfor %}</div>
<section class="technical"><h2 class="section">Metadata Uyarıları</h2><p>{{ view.difference_note if view.difference_note else 'Metadata kapsamı eksik. Ek farklar bulunabilir.' if view.generation.incomplete_metadata_targets else 'Eksik metadata kaydı bulunmuyor.' }}</p><h2 class="section">Bağımlılık Uyarıları</h2><p>{% if view.generation.dependency_warning_operations %}{{ view.generation.dependency_warning_operations|count_tr }} DDL işleminde bağımlılık veya sıralama bilgisi tam doğrulanamadı. Gerekçeler ilgili DDL dosyalarında ve hedef ayrıntılarındadır.{% else %}Bağımlılık uyarısı bulunmuyor.{% endif %}</p>{% if view.generation.other_warning_operations %}<h2 class="section">Diğer DDL Uyarıları</h2><p>{{ view.generation.other_warning_operations|count_tr }} işlemde nesne tanımı veya Oracle uyumluluk notu bulunuyor. Gerekçeler ilgili DDL dosyalarındadır.</p>{% endif %}<p class="small muted">Üretim sonucu SQL uygulama veya derleme doğrulaması değildir.</p></section>
{% with ddl_types=view.ddl_types %}{% include 'ddl_types_web.html.j2' %}{% endwith %}
<div class="spacer"></div>{% with scan_scope=view.scan_scope %}{% include "scan_scope.html.j2" %}{% endwith %}
<div class="spacer"></div><h2 class="section">{{ report_icon('database', 22, accent=True) }} Hedef ve DDL Dosyaları</h2>
<p class="small muted">Her hedefin üretilen DDL dosyaları kendi arşivindedir. SQL veritabanına uygulanmadı.</p>
{% if pages>1 %}<nav class="pagination" aria-label="Hedef sayfaları">{% for n in range(pages) %}<a href="{{ 'index.html' if n==0 else 'targets-%04d.html'|format(n+1) }}"{% if n==page %} aria-current="page"{% endif %}>{{ n+1 }}</a>{% endfor %}</nav>{% endif %}
<div class="targetgrid{{ ' single' if targets|length==1 else '' }}">
{% for t in targets %}<section class="target">
<div class="target-heading"><div><strong data-target-id="{{ t.id }}">{{ t.name }}</strong><p>Karşılaştırılan şemalar {{ t.schemas|join(', ') if t.schemas else 'doğrulanamadı' }}</p></div><span class="pill">{{ t.display_status }}</span></div>
{% if t.counts %}<dl class="target-counts"><div><dt>Bulunan Fark</dt><dd>{{ t.confirmed_difference_count|count_tr if t.confirmed_difference_count is not none else 'Sonuç Alınamadı' }}</dd></div><div data-metric="generated"><dt>Üretilen DDL</dt><dd>{{ t.generated_ddl_count|count_tr }}</dd></div><div><dt>Taranan Nesne</dt><dd>{{ t.source_object_count|count_tr if t.source_object_count is not none else 'Bilinmiyor' }}</dd></div><div data-metric="missing"><dt>DDL Dosyası Eksik</dt><dd>{{ t.missing_ddl_count|count_tr if t.missing_ddl_count is not none else 'Bilinmiyor' }}</dd></div></dl>{% else %}<p>Hedef bilgileri alınamadı.</p>{% endif %}
<p class="target-reason">{{ t.status_reason }}</p>
<div class="toolbar target-actions">{% if t.aggregate_view_path %}<a class="link primary" href="{{ t.aggregate_view_path }}">Genel DDL’i görüntüle</a>{% elif t.aggregate_path %}<a class="link primary" href="{{ t.aggregate_path }}" download>Genel DDL’i indir</a>{% endif %}{% if t.download_path %}<a class="link" href="{{ t.download_path }}">DDL dosyalarını indir</a>{% elif t.objects_path %}<a class="link" href="{{ t.objects_path }}">Nesne bazlı dosyalar</a>{% endif %}{% if t.report_path %}<a class="link" href="{{ t.report_path }}">Hedef ayrıntıları</a>{% endif %}</div>
{% if t.aggregate_path %}<p class="download-note">Genel DDL, nesne dosyalarını sırayla çağıran ana SQL betiğidir. {% if t.download_path %}İndirmek için dosya listesinden tüm dosyaları ZIP olarak alabilirsiniz.{% else %}Ana betik ve nesne dosyalarının dizin yapısını birlikte koruyun.{% endif %}</p>{% endif %}
{% if t.plan_path %}<details class="technical"><summary>Teknik Dosyalar</summary><div class="toolbar"><a class="link" href="{{ t.plan_path }}">Plan JSON</a><a class="link" href="{{ t.manifest_path }}">Dosya doğrulama manifesti</a></div></details>{% endif %}
</section>{% else %}<p>Hedef sonucu bulunmuyor.</p>{% endfor %}</div>
<div class="spacer"></div><h2 class="section">{{ report_icon('details', 22, accent=True) }} Önemli Nesneler</h2><p class="meta">{{ view.unique_objects|count_tr }} benzersiz nesneden ilk {{ view.important_objects|length|count_tr }}. Tam liste ve gerekçeler hedef ayrıntılarındadır.</p>
<div class="tablewrap"><table class="table"><thead><tr><th>Nesne / Tür</th><th>Hedef</th><th>İşlem / Durum</th><th>Gerekçe</th></tr></thead><tbody>{% for o in view.important_objects %}<tr><td><strong>{{ o.object_label }}</strong><br><span class="muted">{{ o.type_label }}</span>{% if o.object.object_type in ['COMMENT','GRANT'] and not o.object.get('display_name') %}<br><a href="{{ o.evidence_path }}">Bağlı nesne kanıtı</a>{% endif %}</td><td>{{ o.target_label }}</td><td>{{ o.kinds|join(', ') }}<br>{{ o.display_status }}</td><td class="small muted">{{ o.mail_reason }}</td></tr>{% else %}<tr><td colspan="4">Raporlanacak nesne yok.</td></tr>{% endfor %}</tbody></table></div>
<div class="spacer"></div><details class="technical"><summary>Kaynak ve Çalışma Kayıtları</summary><p class="wrap meta">{{ 'Oracle Kaynak Kaydı' if view.run.get('source_origin') else 'Kaynak SHA' }} {{ view.run.source_origin.snapshot_id if view.run.get('source_origin') else view.run.source_commit }}<br>Çalışma Kimliği {{ view.run.run_id }}</p><p class="meta">{{ view.link_note }} {% if view.link %}<a href="{{ view.link }}">Çalışma Kaydı</a>{% endif %}</p><div class="toolbar"><a class="link" href="run.json">Çalışma JSON</a><a class="link" href="README.md">Çalışma Açıklaması</a></div></details>
</main><footer class="pad report-footer">© 2026 İnnova Bilişim Çözümleri A.Ş.</footer>
</div></body></html>
