{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runs",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "const": "catalog/1.0"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "path",
          "status",
          "source_commit"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]{1,64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
          },
          "status": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "FAILED"
            ]
          },
          "source_commit": {
            "type": "string",
            "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "path",
          "profile_id",
          "target_id"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
          },
          "profile_id": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
