            "type": "object",
            "additionalProperties": false,
            "properties": {
              "inventory": {
                "enum": [
                  "COMPLETE",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              },
              "ddl": {
                "enum": [
                  "COMPLETE",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              },
              "dictionary": {
                "enum": [
                  "COMPLETE",
                  "PARTIAL",
                  "UNAVAILABLE",
                  "NOT_APPLICABLE"
                ]
              },
              "diagnostics": {
