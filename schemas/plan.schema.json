          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "ddl_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
