<!--[if mso]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" fill="true" stroke="false" style="width:132pt;height:34.5pt"><v:fill type="tile" src="{{ logo_surface }}" color="#F5F5F5"/><v:textbox inset="0,0,0,0"><![endif]-->
<table role="presentation" width="176" border="0" cellpadding="0" cellspacing="0" style="width:176px;border-collapse:collapse"><tr><td class="brand-surface" background="{{ logo_surface }}" bgcolor="#F5F5F5" style="padding:8px 10px;background:#F5F5F5;background-image:url('{{ logo_surface }}');background-image:url('{{ logo_surface }}'),linear-gradient(#F5F5F5,#F5F5F5);background-repeat:repeat;line-height:0;font-size:0"><img src="{{ logo }}" width="156" height="30" alt="İnnova" style="border:0;display:block;width:156px;height:30px"></td></tr></table>
