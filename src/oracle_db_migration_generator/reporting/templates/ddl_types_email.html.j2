{# Şema Karşılaştırma epostasındaki üretilen DDL türlerini gösterir.
Author: Mehmet KARACAN
Date: 2026-11-06 #}
<section aria-label="Üretilen DDL türleri">
<h2 style="margin:0 0 13px;border-left:5px solid #CF1838;padding-left:16px;font-size:21px;line-height:28px;color:#131E30">Üretilen DDL</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" bgcolor="#F3F6F8" style="width:100%;table-layout:fixed;border-collapse:collapse;background:#F3F6F8"><tr>
<td class="scope-total" width="25%" style="width:25%;padding:18px 16px;border-right:1px solid #DFE5EB;vertical-align:middle"><div style="font-size:11px;line-height:17px;color:#68778B;font-weight:700">Toplam DDL İşlemi</div><div style="font-size:28px;line-height:34px;font-weight:700;color:#1B283B">{{ view.ddl_types.total|count_tr }}</div></td>
<td class="scope-breakdown" width="75%" style="width:75%;padding:8px 12px;vertical-align:middle">
{% if view.ddl_types.rows %}<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;table-layout:fixed;border-collapse:collapse">{% for group in view.ddl_types.rows|batch(4) %}<tr>{% for row in group %}<td class="scope-item" width="25%" style="width:25%;padding:7px 6px;vertical-align:top;overflow-wrap:anywhere"><div style="font-size:11px;line-height:17px;color:#68778B">{{ row.label }}</div><div style="font-size:16px;line-height:22px;font-weight:700;color:#1B283B">{{ row.count|count_tr }}</div></td>{% endfor %}</tr>{% endfor %}</table>{% else %}<p style="margin:0;padding:8px 6px;font-size:12px;color:#68778B">{{ 'Bu çalışmada DDL işlemi üretilmedi.' if view.ddl_types.total == 0 else 'DDL tür dağılımı doğrulanamadı.' }}</p>{% endif %}
</td></tr></table>
<p style="margin:8px 0 0;font-size:11px;line-height:17px;color:#788599">Sayılar DDL işlemlerini gösterir. Aynı nesne için birden fazla işlem bulunabilir.</p>
</section>
