{# Oracle DB Migration Generator çalışma özetini eposta için HTML olarak gösterir.
Author: Mehmet KARACAN
Date: 2026-11-02 #}
<!doctype html>
<html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>Schema Compare</title>
{% include "email_styles.html.j2" %}</head>
<body class="mail-bg" style="margin:0!important;padding:0!important;background:#EBF0F4;color:#253142;font-family:Aptos,Calibri,'Segoe UI',Arial,sans-serif;font-size:15px;line-height:1.55;-webkit-text-size-adjust:100%">
<table role="presentation" class="mail-bg" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#EBF0F4" style="border-collapse:collapse;width:100%;background:#EBF0F4"><tr><td class="mail-outer" align="center" style="padding:24px 12px">
<!--[if mso]><table role="presentation" width="820" align="center"><tr><td><![endif]-->
<table role="presentation" class="mail-shell" width="820" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#FFFFFF" style="border-collapse:collapse;margin:0 auto;width:100%;max-width:820px;background:#FFFFFF">
<tr><td class="pad" style="padding:27px 34px 18px">{% include "email_header.html.j2" %}</td></tr>
<tr><td class="pad" style="padding:7px 34px 22px"><table class="timing-summary" role="presentation" cellpadding="0" cellspacing="0" style="margin-top:12px;border-collapse:collapse"><tr><td class="timing-icon" width="30" valign="middle" style="width:30px;min-width:30px;padding:0;vertical-align:middle">{{ report_icon('time', 20) }}</td><td valign="middle" style="padding:0;font-size:14px;line-height:22px;color:#46566B;font-weight:600;vertical-align:middle;overflow-wrap:anywhere">{% if view.comparison_duration_label == 'Ölçülemedi' %}Karşılaştırma süresi ölçülemedi.{% else %}Karşılaştırma {{ view.comparison_duration_label }} sürdü.{% endif %}</td></tr></table></td></tr>
<tr><td class="pad" style="padding:0 34px 25px">{% include "email_metrics.html.j2" %}</td></tr>
{% if view.targets|length == 1 %}<tr><td class="pad" style="padding:0 34px 20px"><p class="mail-note" style="margin:0;font-size:14px;color:#46566B"><strong>{{ view.targets[0].display_status }}</strong></p><p class="mail-muted" style="margin:3px 0 0;font-size:12px;line-height:18px;color:#526174">{{ view.targets[0].status_reason }}</p></td></tr>{% endif %}
<tr><td class="pad" style="padding:0 34px 24px">{% include "ddl_types_email.html.j2" %}</td></tr>
<tr><td class="pad" style="padding:0 34px 24px">{% with scan_scope=view.scan_scope %}{% include "scan_scope.html.j2" %}{% endwith %}</td></tr>
<tr><td class="pad" style="padding:0 34px 20px">{% include "generation_warnings_email.html.j2" %}</td></tr>
<tr><td class="pad" style="padding:0 34px 23px"><p class="mail-note" style="margin:0;color:#526174;font-size:12px;line-height:18px">Hazırlanan SQL veritabanına uygulanmadı. Kaynak ve hedef salt okunur.</p></td></tr>
{% if view.targets|length != 1 %}
<tr><td class="pad" style="padding:0 34px 25px">{% with heading_icon='database', heading_label='Hedef Ortam Özeti' %}{% include "email_heading.html.j2" %}{% endwith %}<table role="table" class="data-table mail-border" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #DCE4EB;border-collapse:collapse;width:100%;table-layout:fixed"><thead><tr><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Hedef</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Bulunan Fark</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'Üretilen DDL' if view.proposal_catalog_known else 'DDL' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'Taranan Nesne' if view.proposal_catalog_known else 'İnceleme' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">{{ 'DDL Dosyası Eksik' if view.proposal_catalog_known else 'Üretilemeyen DDL' }}</th><th align="left" style="padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Durum</th></tr></thead><tbody>{% for t in view.critical_targets %}<tr><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><strong data-target-id="{{ t.id }}">{{ t.name }}</strong>{% if t.schema_subtitle %}<br>{{ t.schema_subtitle }}{% endif %}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.confirmed_difference_count|count_tr if t.confirmed_difference_count is not none else 'Sonuç alınamadı' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.generated_ddl_count|count_tr if view.proposal_catalog_known and t.counts else t.counts.ready_operations|count_tr if t.counts else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.source_object_count|count_tr if view.proposal_catalog_known and t.source_object_count is not none else t.counts.review_operations|count_tr if t.counts and not view.proposal_catalog_known else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.missing_ddl_count|count_tr if view.proposal_catalog_known and t.counts else t.counts.blocked_operations|count_tr if t.counts else 'Bilinmiyor' }}</td><td style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">{{ t.display_status }}<div style="font-size:12px;line-height:18px;color:#526174;margin-top:4px">{{ t.status_reason }}</div></td></tr>{% else %}<tr><td colspan="6" style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">Hedef sonucu bulunmuyor.</td></tr>{% endfor %}</tbody></table><p class="mail-note" style="color:#526174;font-size:12px;line-height:18px;margin:8px 0 0">Çok sayıda hedef bulunduğunda e-postada en yüksek öncelikli 5 hedef gösterilir. Tam liste artifact paketindedir.</p></td></tr>
{% endif %}
<tr><td class="pad" style="padding:0 34px 24px">{% with heading_icon='details', heading_label='Değişiklik Detayları' %}{% include "email_heading.html.j2" %}{% endwith %}<p class="mail-note" style="font-size:12px;color:#526174;margin:0 0 10px">Önem sırasına göre en fazla 5 benzersiz nesne. Aynı nesnenin birden fazla hedefteki farkları tek satırda özetlenir.</p><table role="table" class="data-table mail-border" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #DCE4EB;border-collapse:collapse;width:100%;table-layout:fixed"><thead><tr class="detail-head"><th width="58%" align="left" style="width:58%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Nesne / Fark</th><th width="25%" align="left" style="width:25%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Hedef</th><th width="17%" align="left" style="width:17%;padding:10px 10px;border-bottom:1px solid #D5DFE8;background:#EDF1F5;font-size:12px;color:#26354A;text-align:left">Sonuç</th></tr></thead><tbody>{% for o in view.important_objects %}<tr class="detail-row"><td class="detail-cell" style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><strong>{{ o.object_label }}</strong><br>{{ o.type_label }}<div class="object-reason" style="margin-top:5px;font-size:12px;line-height:18px;color:#526174;white-space:normal;overflow-wrap:anywhere;word-break:break-word">{{ o.mail_reason }}</div></td><td class="detail-cell" style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><span class="mobile-label" style="display:none;mso-hide:all">Hedef Şema</span>{{ o.target_label }}</td><td class="detail-cell" style="padding:10px 10px;vertical-align:top;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere"><span class="mobile-label" style="display:none;mso-hide:all">Sonuç</span>{{ o.display_status }}</td></tr>{% else %}<tr><td colspan="3" style="padding:10px 10px;border-bottom:1px solid #E4E9EE;font-size:12px;line-height:17px;color:#3C4F67;overflow-wrap:anywhere">Raporlanacak nesne yok.</td></tr>{% endfor %}</tbody></table><div class="mail-panel mail-note" style="margin-top:10px;background:#F3F6F8;color:#46566B;padding:12px 16px;font-size:12px;line-height:19px">{{ view.unique_objects|count_tr }} benzersiz nesneden {{ view.important_objects|length|count_tr }} nesne gösterildi. Tüm nesneler ve üretilen DDL dosyaları ayrıntılı raporda bulunur.</div></td></tr>
<tr><td class="pad" style="padding:0 34px 25px">{% with heading_icon='connections', heading_label='Kaynak ve İzlenebilirlik' %}{% include "email_heading.html.j2" %}{% endwith %}<table role="presentation" width="100%" cellspacing="0" cellpadding="0" class="mail-panel" bgcolor="#F3F6F8" style="background:#F3F6F8;border-collapse:collapse"><tr><td class="trace-cell" width="50%" valign="top" style="padding:16px;font-size:12px;line-height:20px;color:#48576D;border-right:1px solid #DEE5EC"><strong style="color:#27364A">{{ 'Oracle Kaynak Snapshot' if view.run.get('source_origin') else 'Kaynak SHA' }}</strong> <span style="overflow-wrap:anywhere;word-break:break-all">{{ view.run.source_origin.snapshot_id if view.run.get('source_origin') else view.run.source_commit }}</span><br><strong style="color:#27364A">Çalışma Kimliği</strong> <span style="overflow-wrap:anywhere;word-break:break-all">{{ view.run.run_id }}</span><br><strong style="color:#27364A">Kapsam</strong> Bir kaynak ve {{ view.metrics[0].value }} hedef</td><td class="trace-cell" width="50%" valign="top" style="padding:16px;font-size:12px;line-height:20px;color:#48576D"><strong style="color:#27364A">Çalışma</strong> {{ view.run.get('build_number') if view.run.get('build_number') is not none else 'Yerel' }}<br><strong style="color:#27364A">Sonuç</strong> {{ view.sql_result }}</td></tr></table><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td style="padding:17px 0 0">{% include "email_ddl_links.html.j2" %}<p class="mail-note" style="font-size:12px;line-height:17px;color:#526174;margin:6px 0 0">{{ view.link_note }}</p></td></tr></table></td></tr>
<tr><td class="pad" style="border-top:1px solid #E3E8ED;padding:18px 34px 23px"><table role="presentation" width="100%"><tr><td class="footer-cell mail-muted" style="font-size:12px;color:#526174">© 2026 İnnova Bilişim Çözümleri A.Ş.</td><td class="footer-cell mail-muted" align="right" style="font-size:12px;color:#526174"><strong>SQL veritabanına uygulanmadı.</strong></td></tr></table></td></tr>
</table><!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>
